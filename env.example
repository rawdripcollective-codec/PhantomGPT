# ---- LLM ----
LLM_API_KEY=
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_MODEL=venice-uncensored-1-2
TEMPERATURE=0.35
MAX_TOOL_ROUNDS=8

# ---- database ----
DB_PATH=phantomgpt.db

# ---- recon behaviour ----
TOOLS_DEFAULT=1
PREFLIGHT=1
PREFLIGHT_BUDGET=12
CACHE_TTL=900
HOST_RATE=2
HOST_BURST=4

# ---- scope (comma list, supports *.example.com; empty = allow all) ----
SCOPE_ALLOW=

# ---- intel providers (all optional) ----
SHODAN_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
DEHASHED_EMAIL=
DEHASHED_KEY=

# ---- builder ----
BUILDER_MODEL=venice-uncensored-1-2
BUILDER_MODELS=venice-uncensored-1-2
BUILDER_MAX_ROUNDS=12
WORKSPACE_ROOT=workspaces
EXEC_TIMEOUT=180
ALLOW_SHELL=1

# ---- card checker ----
STRIPE_KEY=
BINLOOKUP=1
CHECK_CONCURRENCY=4
CHECK_DELAY=0.35
MAX_CHECK=300

# ---- egress ----
SSLOCAL_BIN=sslocal
EGRESS_ROTATION=sticky
FAIL_CLOSED=1
LEAK_TIMEOUT=12
SCRUB_WORKSPACES=1
